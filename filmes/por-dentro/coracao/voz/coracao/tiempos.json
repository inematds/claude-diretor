 "frases": [
  {
   "id": "titulo",
   "bloque": "b0",
   "texto": "Seu coração por dentro.",
   "inicio": 0.0,
   "fin": 1.24
  },
  {
   "id": "batidas",
   "bloque": "b1",
   "texto": "Ele bate cerca de cem mil vezes por dia e empurra uns sete mil e quinhentos litros de sangue.",
   "inicio": 1.82,
   "fin": 7.88
  },
  {
   "id": "camaras",
   "bloque": "b2",
   "texto": "Por dentro, são quatro câmaras: dois átrios em cima, dois ventrículos embaixo.",
   "inicio": 8.46,
   "fin": 13.82
  },
  {
   "id": "azul",
   "bloque": "b3",
   "texto": "O sangue sem oxigênio chega pelo lado direito e sai para os pulmões.",
   "inicio": 14.4,
   "fin": 18.78
  },
  {
   "id": "vermelho",
   "bloque": "b4",
   "texto": "Volta cheio de oxigênio pelo lado esquerdo, e o ventrículo esquerdo manda tudo pela aorta.",
   "inicio": 19.36,
   "fin": 25.043
  },
  {
   "id": "valvulas",
   "bloque": "b5",
   "texto": "Quatro válvulas impedem a volta. O tum-tá que você escuta é o barulho delas fechando.",
   "inicio": 25.453,
   "fin": 30.873
  },
  {
   "id": "sinal",
   "bloque": "b6",
   "texto": "E quem dá o ritmo é um sinal elétrico que nasce no átrio direito.",
   "inicio": 31.453,
   "fin": 35.213
  },
  {
   "id": "pecas",
   "bloque": "b7",
   "texto": "Peça por peça, trabalhando sem parar.",
   "inicio": 35.793,
   "fin": 38.193
  },
  {
   "id": "volta",
   "bloque": "b8",
   "texto": "Como funciona por dentro. Tem mais no INEMA.CLUB.",
   "inicio": 38.773,
   "fin": 41.993
  }
 ],
