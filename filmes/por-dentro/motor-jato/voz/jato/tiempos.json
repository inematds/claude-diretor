 "frases": [
  {
   "id": "titulo",
   "bloque": "b0",
   "texto": "Um motor a jato por dentro.",
   "inicio": 0.0,
   "fin": 1.78
  },
  {
   "id": "fan",
   "bloque": "b1",
   "texto": "Na frente, um ventilador gigante. No maior motor de avião comercial, ele é mais largo que um Boeing setecentos e trinta e sete.",
   "inicio": 2.36,
   "fin": 11.26
  },
  {
   "id": "bypass",
   "bloque": "b2",
   "texto": "A maior parte do ar passa por fora: cerca de dez vezes mais do que entra no núcleo.",
   "inicio": 11.67,
   "fin": 17.15
  },
  {
   "id": "compressor",
   "bloque": "b3",
   "texto": "O resto é espremido, estágio por estágio, até sessenta vezes a pressão.",
   "inicio": 17.654,
   "fin": 22.754
  },
  {
   "id": "combustao",
   "bloque": "b4",
   "texto": "Aí, o combustível queima nesse ar apertado.",
   "inicio": 23.331,
   "fin": 26.231
  },
  {
   "id": "turbina",
   "bloque": "b5",
   "texto": "O gás quente gira a turbina, e ela gira o compressor e o ventilador por dois eixos, um dentro do outro.",
   "inicio": 26.808,
   "fin": 33.408
  },
  {
   "id": "bocal",
   "bloque": "b6",
   "texto": "No bocal, o gás sai rápido, e o avião é empurrado para a frente.",
   "inicio": 33.988,
   "fin": 38.128
  },
  {
   "id": "pecas",
   "bloque": "b7",
   "texto": "Aspira, comprime, queima e sopra. Peça por peça.",
   "inicio": 38.708,
   "fin": 42.948
  },
  {
   "id": "volta",
   "bloque": "b8",
   "texto": "Como funciona por dentro. Tem mais no INEMA.CLUB.",
   "inicio": 43.528,
   "fin": 46.548
  }
 ],
